# Inactive template. T00 must implement the application and enable as app-ci.yml.
name: App CI
'on':
  push:
  pull_request:
permissions:
  contents: read
jobs:
  backend-tests:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: ledger_test
          POSTGRES_PASSWORD: ci-only-disposable
          POSTGRES_DB: ledger_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U ledger_test -d ledger_test"
          --health-interval 5s --health-timeout 5s --health-retries 10
    env:
      APP_ENV: test
      PYTHONPATH: backend
      DATABASE_URL: postgresql+psycopg://ledger_test:ci-only-disposable@localhost:5432/ledger_test
      ALLOW_TEST_DOUBLES: '1'
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m pip install -r backend/requirements-dev.txt
      - name: Generate disposable test keys
        run: |
          python - <<'PY'
          import base64, os, secrets
          with open(os.environ['GITHUB_ENV'], 'a', encoding='utf-8') as f:
              f.write('DATA_ENCRYPTION_KEY=' + base64.urlsafe_b64encode(os.urandom(32)).decode() + '\n')
              f.write('SESSION_SECRET=' + secrets.token_hex(32) + '\n')
          PY
      - name: Run actual backend tests; no tests is a failure
        run: |
          mkdir -p test-results
          python -m pytest backend/tests --junitxml=test-results/backend.xml
  frontend-build:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: npm
          cache-dependency-path: frontend/package-lock.json
      - run: npm ci
      - run: npm run typecheck
      - run: npm run lint
      - run: npm run build
