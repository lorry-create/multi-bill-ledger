            ]
          }
        }
      ]
    },
    {
      "name": "PATCH /api/classification-rules/{id} [patchRule]",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/classification-rules/{{ruleId}}",
        "description": "至少提供enabled或category，携带expected_version；已停用规则可重新启用。停用不重写历史交易。\n请求中的版本、row_id和字段必须按实际返回核对。",
        "body": {
