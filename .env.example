# T00 已实现下列配置项（仅此处为示例，真实密钥写 .env，已被 .gitignore 排除）。
# 本地开发：cd backend && python -m app.migrate && uvicorn app.main:app --reload
# 容器部署：cp .env.example .env 后填 POSTGRES_PASSWORD 等，再 docker compose up -d

APP_ENV=development
APP_PORT=8000

# 留空 = 使用 backend/local-data/app.db（SQLite，仅本地开发）
# PostgreSQL 示例：postgresql+psycopg://ledger:密码@127.0.0.1:5432/ledger
DATABASE_URL=

# 生产环境必填，缺失会拒绝启动；开发留空则自动生成到
# backend/local-data/dev_secrets.json（不入库，重启后仍可解密旧数据）
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# 走 HTTPS 时设为 1；本地 http 开发保持 0，否则 Cookie 不会被浏览器保存
COOKIE_SECURE=0
SESSION_TTL_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# docker compose 的 PostgreSQL 服务
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=
APP_PORT_HOST=8000

# 智能模块（D 负责实现；后端通过 app/intelligence 的协议调用，不直接 import D 的代码）
# INTELLIGENCE_PROVIDER 决定用哪个实现：
#   fallback-rules          纯规则，零外部依赖，永远可用（默认）
#   app.intelligence.deepseek:DeepSeekIntelligence    D 的完整实现（离线 RapidOCR + DeepSeek 分类）
# 注意：配置成不存在的实现会启动即失败，不会静默退回 fallback——否则分类来源会撒谎。
INTELLIGENCE_PROVIDER=fallback-rules
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OCR_PROVIDER=rapidocr
OCR_API_KEY=
ALLOW_TEST_DOUBLES=0

# ---- 导出（T08/T09） ----
# 单次 CSV 导出行数上限，超过返回 422 而不是悄悄截断
EXPORT_MAX_ROWS=50000

# 月报 PDF 的中文字体。留空则按内置候选列表自动搜索
# （Windows 找 simhei/msyh，Linux 找文泉驿）。
# 必须用 TrueType 轮廓的字体：reportlab 嵌不了 Noto CJK 那类 CFF/OTF。
# Dockerfile 已装 fonts-wqy-zenhei 并把这一项指到：
#   /usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
# 找不到字体时 /api/exports/monthly.pdf 会如实返回 503 EXPORT_UNAVAILABLE，
# 不会输出一份中文全是方块的 PDF 冒充成功。
PDF_FONT_PATH=
